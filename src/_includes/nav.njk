{#- Top navigation: a yellow MENU button on the left, the logo in the middle and the night mode switch on the right.
    The button drops down a black full-screen panel (#site-menu): the pages on the left, in the page-title style, white,
    turning yellow on hover, and our contact details on the right. Behaviour in js/site-menu.js, styles in the
    "Menu" block of css/site.css. The Services link jumps to /services; the categories are listed under it. -#}
{%- macro current(url) %}{% if page.url | replace(".html", "") == url %} aria-current="page"{% endif %}{% endmacro -%}
    <div class="section bg-transparent site-nav" data-w-id="49f5e56c-8521-8763-403a-7fb5a593df04" role="banner">
      <div class="container site-nav_bar">
        <div class="site-nav_left">
          <button type="button" class="menu-toggle" aria-expanded="false" aria-controls="site-menu" data-menu-toggle>
            <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M3 6h18M3 12h18M3 18h18" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/></svg>
            <span>Menu</span>
          </button>
        </div>
        <a href="/"{{ current("/") }} class="site-nav_logo"><img loading="eager" src="/images/MClogo.avif" alt="Made Clear Studios home" class="width-100-pct"></a>
        <div class="site-nav_right">
          {%- set extraClass = "" %}{% include "night-toggle.njk" %}
        </div>
      </div>
      <div class="divider absolute bottom-0 left-0"></div>
      {%- if navDivider %}
      <div class="divider-dark absolute bottom-0 left-0"></div>
      {%- endif %}
    </div>
    <div class="site-menu section" id="site-menu" role="dialog" aria-modal="true" aria-label="Menu" data-site-menu>
      <div class="container site-nav_bar site-menu_bar">
        <div class="site-nav_left">
          <button type="button" class="menu-toggle" data-menu-close>
            <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M5 5l14 14M19 5L5 19" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/></svg>
            <span>Close</span>
          </button>
        </div>
        <a href="/" class="site-nav_logo"><img src="/images/MClogo.avif" alt="Made Clear Studios home" class="width-100-pct site-menu_logo" loading="lazy"></a>
        <div></div>
      </div>
      <div class="container site-menu_inner">
        <nav class="site-menu_nav" aria-label="Main">
          <ul role="list" class="site-menu_list">
            {%- for item in [
              { url: "/about", label: "About" },
              { url: "/services", label: "Services" },
              { url: "/case-studies", label: "Case Studies" },
              { url: "/kol-hub", label: "KOL Hub" },
              { url: "/insights", label: "Insights" },
              { url: "/contact", label: "Contact" }
            ] %}
            <li class="site-menu_item">
              <a href="{{ item.url }}"{{ current(item.url) }} class="site-menu_link">{{ item.label }}</a>
              {%- if item.url == "/services" %}
              <ul role="list" class="site-menu_sub">
                {%- for cat in serviceCategories | published %}
                <li><a href="/services#{{ cat.slug }}" class="site-menu_sublink">{{ cat.name }}</a></li>
                {%- endfor %}
              </ul>
              {%- endif %}
            </li>
            {%- endfor %}
          </ul>
        </nav>
        <div class="site-menu_contact">
          <p class="site-menu_label">Get in touch</p>
          <p>62 St. Bernards Road, Oxford, OX2 6EJ<br><a href="mailto:hello@madeclearstudios.com">hello@madeclearstudios.com</a><br><a href="tel:+441865965389">+44 (0) 1865 965389</a></p>
          <div class="site-menu_actions">
            <a href="/contact" class="button primary w-inline-block"><div>Contact us</div><div class="hover-button-blur"></div></a>
            <a href="https://www.linkedin.com/company/made-clear-studios/" target="_blank" rel="noopener" class="site-menu_social">LinkedIn</a>
          </div>
        </div>
      </div>
    </div>
    <script src="/js/site-menu.js" defer></script>
