{#- A horizontal rail of project cards: one continuous row that runs off the right edge of the screen, so the last
    card is cut off and can be dragged (mouse) or swiped (touch) into view. The year on the left changes to the
    year of the cards in view as the row moves. Expects `railMicros` (micro case studies) and, optionally,
    `railCases` (full case studies). Both are mixed into one row, newest first by year and month (workRailMix
    filter); case studies are marked "Case study" and, with no year set, sit at the end labelled "Case study".
    Behaviour in js/work-rail.js, styles in the "Work rail" block of css/site.css. -#}
{%- set railItems = (railMicros or []) | workRailMix(railCases or []) %}
{%- set railFirstItem = railItems[0] if railItems.length else null %}
{%- set railFirst = (railFirstItem.item.year or ("Case study" if railFirstItem.kind == "case" else "")) if railFirstItem else "" %}
<div class="work-rail" data-work-rail>
  <div class="work-rail_year" aria-hidden="true">
    <p class="text-size-xsmall font-600 text-color-grey-4 work-rail_year-eyebrow">Year</p>
    <p class="h2 work-rail_year-value" data-work-rail-year>{{ railFirst }}</p>
  </div>
  <div role="list" class="work-rail_track" data-work-rail-track tabindex="0" aria-label="Projects, newest first. Scroll sideways for more.">
    {%- for entry in railItems %}
    {%- set m = entry.item %}
    {%- set mDate = [m.month, m.year] | select | join(" ") %}
    {%- if entry.kind == "micro" %}
    <div role="listitem" class="work-rail_item" data-year="{{ m.year or '' }}">
      <a href="/work/{{ m.slug }}" class="border-1 radius-0-25 padding-1-5 width-100-pct m_padding-1-25 height-100-pct flex vertical gap-1 work-tile w-inline-block" draggable="false">
        {%- if m.coverPhoto %}<img src="{{ m.coverPhoto }}" loading="lazy" alt="{{ m.title }}" class="width-100-pct _16x9 fit-cover radius-0-25" draggable="false">
        {%- else %}<div class="width-100-pct _16x9 radius-0-25 media-placeholder">Photo</div>{% endif %}
        <div class="flex vertical gap-0-5">
          {%- if mDate %}<p class="text-size-xsmall font-600 text-color-grey-4">{{ mDate }}</p>{% endif %}
          <h3>{{ m.title }}</h3>
          <p>{{ m.summary }}</p>
        </div>
        <div class="work-tile_link"><span class="service-name-highlight">Find out more<span class="visually-hidden"> about {{ m.title }}</span></span></div>
      </a>
    </div>
    {%- else %}
    <div role="listitem" class="work-rail_item" data-year="{{ m.year or 'Case study' }}">
      <a href="/case-study/{{ m.slug }}" class="border-1 radius-0-25 padding-1-5 width-100-pct m_padding-1-25 height-100-pct flex vertical gap-1 work-tile w-inline-block" draggable="false">
        {%- if m.coverPhoto %}<img src="{{ m.coverPhoto }}" loading="lazy" alt="{{ m.title }}" class="width-100-pct _16x9 fit-cover radius-0-25" draggable="false">
        {%- else %}<div class="width-100-pct _16x9 radius-0-25 media-placeholder">Photo</div>{% endif %}
        <div class="flex vertical gap-0-5">
          <p class="text-size-xsmall font-600 text-color-grey-4">{{ (mDate + " · Case study") if mDate else "Case study" }}</p>
          <h3>{{ m.title }}</h3>
          <p>{{ m.overview }}</p>
        </div>
        <div class="work-tile_link"><span class="service-name-highlight">Find out more<span class="visually-hidden"> about {{ m.title }}</span></span></div>
      </a>
    </div>
    {%- endif %}
    {%- endfor %}
  </div>
</div>
