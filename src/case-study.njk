</style>
    </div>
    {% include "nav.njk" %}
    <main class="main">
      {#- Header: client, then the project name (highlighted), then the summary, centred. From the case study's
          "Client name" and "Project title" in Pages CMS (older items: split from the title at " | "). -#}
      {%- set csClient = clients | findBy("slug", cs.client) %}
      {%- set titleParts = cs.title.split(" | ") if cs.title else [] %}
      {%- set clientLine = cs.clientName or (titleParts[0] if titleParts.length > 1 else (csClient.name if csClient else "")) %}
      {%- set projectLine = cs.projectTitle or (titleParts.slice(1).join(" | ") if titleParts.length > 1 else cs.title) %}
      {#- Previous / next case study, like a slideshow: arrows either side of the header on desktop, a row above
          the breadcrumb on tablet and phone. The left and right arrow keys work too. Wraps round at the ends.
          Behaviour in js/case-study-nav.js, styles in css/site.css. -#}
      {%- set allCases = caseStudies | published | sortByOrder %}
      {%- set csIndex = allCases.indexOf(cs) %}
      <section class="section padding-5 case-hero">
      {%- if allCases.length > 1 %}
      {%- set prevCase = allCases[(csIndex - 1 + allCases.length) % allCases.length] %}
      {%- set nextCase = allCases[(csIndex + 1) % allCases.length] %}
      <nav class="case-pager" aria-label="More case studies">
        <a href="/case-study/{{ prevCase.slug }}" class="case-pager_link is-prev" rel="prev" data-case-nav="prev">
          <svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <span class="case-pager_label"><span class="case-pager_dir">Previous</span><span class="case-pager_name">{{ prevCase.projectTitle or prevCase.title }}</span></span>
        </a>
        <a href="/case-study/{{ nextCase.slug }}" class="case-pager_link is-next" rel="next" data-case-nav="next">
          <span class="case-pager_label"><span class="case-pager_dir">Next</span><span class="case-pager_name">{{ nextCase.projectTitle or nextCase.title }}</span></span>
          <svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
      </nav>
      {%- endif %}
        <div class="container-medium">
          <div class="flex vertical align-center text-align-center gap-1-25">
            <nav aria-label="Breadcrumb" class="service-breadcrumb case-breadcrumb"><a href="/case-studies">Case Studies</a><span><span aria-hidden="true" class="case-breadcrumb_sep">/</span><span aria-current="page">{{ projectLine }}</span></span></nav>
            <h1 class="h2 case-hero_title">
              {%- if clientLine %}<span class="case-hero_client">{{ clientLine }}</span>{% endif -%}
              <span class="case-hero_project"><span class="services-highlight is-multiline highlight-tight">{{ projectLine }}</span></span>
            </h1>
            <div class="max-w-498">
              <p class="{{ ' w-dyn-bind-empty' if not cs.overview }}">{{ cs.overview }}</p>
            </div>
          </div>
        </div>
      </section>

      {#- Two columns: the cover photo and services stay in place on the left while the featured videos and the
          story scroll past on the right; the rest of the page follows at full width. Needs .case-page
          (overflow: clip on the page wrapper) for position: sticky; styles in css/site.css. -#}
      {%- set vids = cs.videos | playableVideos %}
      <section class="section padding-5 case-body">
        <div class="container relative">
          <div class="grid _12-col gap-1 t_flex t_vertical">
            <div class="_4-col case-body_aside">
              <div class="case-body_sticky flex vertical gap-2 t_gap-1-5">
                {%- if cs.coverPhoto %}
                <div class="relative radius-0-25 overflow-hidden"><img src="{{ cs.coverPhoto }}" loading="eager" alt="" class="width-100-pct _16x9 radius-0-25 case-body_cover">
                  <div class="overlay-wrapper"></div>
                </div>
                {%- endif %}
                <div class="flex vertical gap-1 align-start">
                  <h3 class="h4 relative">Services</h3>
                  <div class="w-dyn-list">
                    <div role="list" class="w-dyn-items">
                      {%- for service in services | published | whereIn("slug", cs.services) %}
                      <div role="listitem" class="w-dyn-item">
                        <p class="text-size-xsmall font-600 text-color-grey-4">{{ service.name }}</p>
                      </div>
                      {%- endfor %}
                    </div>
                  </div>
                </div>
              </div>
            </div>
            <div class="_8-col case-body_main">
              {#- Gallery: at the top of the right column, above the story, as on micro case studies. Opens in the lightbox.
                  (The CMS field is still called imageSlider.) -#}
              {%- set csGallery = cs.imageSlider or [] %}
              {%- if csGallery.length %}
              <div class="media-grid case-gallery">
                {%- for img in csGallery %}
                {%- set src = img.src or img %}
                <a href="#" class="media-grid-item w-inline-block w-lightbox" aria-label="Open photo">
                  <img src="{{ src }}" loading="lazy" alt="{{ img.alt or '' }}">
                  <script type="application/json" class="w-json">{{ { items: [{ url: src, type: "image" }], group: "gallery" } | dump | replace("<", "\\u003c") | safe }}</script>
                </a>
                {%- endfor %}
              </div>
              <div class="height-4 t_height-3"></div>
              {%- endif %}
              <div class="flex vertical gap-5 t_gap-4 m_gap-3">
                <div class="flex vertical gap-1">
                  <h2 class="relative{{ ' w-dyn-bind-empty' if not cs.title1 }}">{{ cs.title1 }}</h2>
                  <div class="text-rich-text w-richtext{{ ' w-dyn-bind-empty' if not cs.body1 }}">{{ cs.body1 | safe }}</div>
                </div>
                <div class="flex vertical gap-1">
                  <h2 class="relative{{ ' w-dyn-bind-empty' if not cs.title2 }}">{{ cs.title2 }}</h2>
                  <div class="text-rich-text w-richtext{{ ' w-dyn-bind-empty' if not cs.body2 }}">{{ cs.body2 | safe }}</div>
                </div>
                <div class="flex vertical gap-1">
                  <h2 class="relative{{ ' w-dyn-bind-empty' if not cs.title3 }}">{{ cs.title3 }}</h2>
                  <div class="text-rich-text w-richtext{{ ' w-dyn-bind-empty' if not cs.body3 }}">{{ cs.body3 | safe }}</div>
                </div>
                <div class="flex vertical gap-1">
                  <h2 class="relative{{ ' w-dyn-bind-empty' if not cs.title4 }}">{{ cs.title4 }}</h2>
                  <div class="text-rich-text w-richtext{{ ' w-dyn-bind-empty' if not cs.body4 }}">{{ cs.body4 | safe }}</div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>
      {%- if cs.testimonial %}
      <section class="section padding-5">
        <div class="container-medium">
          <div class="max-w-440 margin-0-auto">
            <div class="flex vertical gap-4 t_gap-1-5 text-align-center align-center">
              <blockquote class="text-align-center">{{ cs.testimonial }}</blockquote>
              <figcaption class="flex vertical align-center gap-2 t_gap-1-5">
                <div class="flex vertical align-center text-align-center">
                  <div class="h3">{{ cs.authorName }}</div>
                  <div class="text-size-xsmall text-italicize-italic font-500">{{ cs.authorRoleLine1 }}</div>
                  <div class="text-size-xsmall text-italicize-italic font-500">{{ cs.authorRoleLine2 }}</div>
                </div>
              </figcaption>
            </div>
          </div>
        </div>
      </section>
      {%- endif %}
      {#- All the videos, two to a row (one video runs full width) -#}
      {%- if vids.length %}
      <section class="section padding-5">
        <div class="container">
          <div class="video-gallery">
            <div class="grid _12-col gap-5 row-gap-3 t_flex t_vertical">
              {%- for video in vids %}
              <div class="{{ '_12-col' if vids.length == 1 else '_6-col' }}">
                {% include "video-lightbox.njk" %}
              </div>
              {%- endfor %}
            </div>
          </div>
        </div>
      </section>
      {%- endif %}
      <section class="section padding-5">
        <div class="container">
          <div class="flex vertical align-center text-align-center">
            <div class="relative flex justify-center">
              <h2 class="h2">Further Case Studies</h2><img loading="lazy" src="/images/Vector-1.svg" alt="" class="vector-bg">
            </div>
          </div>
          <div class="height-2 m_height-1-5"></div>
          <div class="w-dyn-list">
            <div role="list" class="grid _12-col gap-1-25 t_flex t_vertical w-dyn-items">
              {#- Same compact cards as Recent work on service pages: photo, title, overview, and a link that gets the
                  yellow highlighter on hover (.work-tile in css/site.css). The title already names the client. -#}
              {%- for other in (caseStudies | published | sortByOrder | except(cs)).slice(0, 3) %}
              <div role="listitem" class="_4-col w-dyn-item">
                <a href="/case-study/{{ other.slug }}" class="border-1 radius-0-25 padding-1-5 width-100-pct m_padding-1-25 height-100-pct flex vertical gap-1 work-tile w-inline-block">
                  {%- if other.coverPhoto %}<img src="{{ other.coverPhoto }}" loading="lazy" alt="" class="width-100-pct _16x9 fit-cover radius-0-25">{% endif %}
                  <div class="flex vertical gap-0-5">
                    <h3 class="h4">{{ other.title }}</h3>
                    <p class="text-size-small{{ ' w-dyn-bind-empty' if not other.overview }}">{{ other.overview }}</p>
                  </div>
                  <div class="work-tile_link"><span class="service-name-highlight">View the case study</span></div>
                </a>
              </div>
              {%- endfor %}
            </div>
          </div>
        </div>
      </section>
      <div class="border-1 bg-cream">
        <div class="form-wrapper">
          {% include "enquiry-form.njk" %}
          <div class="divider-dark"></div>
        </div>
        {% include "footer.njk" %}
      </div>
    </main>
  </div>
  <script src="/js/jquery-3.5.1.min.js" type="text/javascript"></script>
  <script src="/js/webflow.js" type="text/javascript"></script>
  <script src="/js/contact-form.js" type="text/javascript"></script>
  <script src="/js/case-study-nav.js" type="text/javascript"></script>
  <script>
  document.addEventListener('DOMContentLoaded', () => {
    /* Navlink Services Click START */
    document.querySelectorAll('.service-link').forEach(function (link) {
      link.addEventListener('click', function (e) {
        e.preventDefault();
        const text = link.textContent.trim();
        const id = text.toLowerCase().replace(/\s+/g, '-');
        const href = link.getAttribute('href');
        const url = new URL(href, window.location.origin);
        url.hash = id;
        window.location.href = url.toString();
      });
    });
    /* Navlink Services Click END */
    /* Testimonials Slider START */
    const testimonialsSliderParent = document.querySelector('#testimonial-slider');
    if (testimonialsSliderParent) {
      const items = testimonialsSliderParent.querySelectorAll('.testimonial-item');
      if (items.length > 2) {
        testimonialsSliderParent.className = 'splide';
        const track = testimonialsSliderParent.children[0];
        const list = track && track.children[0];
        if (track && list) {
          track.className = 'splide__track';
          list.className = 'splide__list';
          items.forEach((item) => {
            item.className = 'splide__slide';
          });
          const testimonialsSlider = new Splide('#testimonial-slider', {
            type: 'loop', // endless: after the last testimonial comes the first again
            arrowPath:
            'M33.5488 18.7969C34.3537 19.3967 34.3537 20.6033 33.5488 21.2031L15.6465 34.5391C14.6571 35.2761 13.2502 34.5706 13.25 33.3369L13.25 6.66309C13.2502 5.42944 14.6571 4.72389 15.6465 5.46094L33.5488 18.7969Z',
            classes: {
              arrows: 'splide__arrows c_slider-arrows',
              arrow: 'splide__arrow c_slider-arrow',
            },
            pagination: false,
            gap: '6rem',
            perPage: 2,
            breakpoints: {
              992: {
                perPage: 1,
              },
            },
          });
          testimonialsSlider.mount();
        }
      }
    }
    /* Testimonials Slider END */
    /* Do not add anything below this code */
    const canvases = document.querySelectorAll('.water-bubble');
    if (canvases.length) {
      const imageUrls = {
        'bubble-img-1': '/images/uploads/webflow/69dce65c7c01004820066763_hi-res-blob.avif',
        'bubble-img-2': '/images/uploads/webflow/6a059765cccbeea156bde1d2_blob-2.avif',
        'bubble-img-3': '/images/uploads/webflow/6a059765bb71a895e802fd7b_blob-3.avif',
        'bubble-img-4': '/images/uploads/webflow/6a05976502ec2a1b90a4195c_blob-4.avif',
        'bubble-img-5': '/images/uploads/webflow/6a059765cf706bfa1d20de94_blob-5.avif',
        'bubble-img-6': '/images/uploads/webflow/6a05976536cc83c2cccefd95_blob-6.avif',
      };
      function getImageUrl(canvasEl) {
        for (const className in imageUrls) {
          if (canvasEl.classList.contains(className)) {
            return imageUrls[className];
          }
        }
        return imageUrls['bubble-img-1'];
      }
      canvases.forEach(initCanvas);
      function initCanvas(canvasEl) {
        const scene = new THREE.Scene();
        const simScene = new THREE.Scene();
        const camera = new THREE.OrthographicCamera(-1, 1, 1, -1, 0.1, 10);
        camera.position.z = 1;
        const renderer = new THREE.WebGLRenderer({
          canvas: canvasEl,
          antialias: true,
          alpha: true,
          preserveDrawingBuffer: true,
        });
        const mouse = new THREE.Vector2(0, 0);
        let frame = 0;
        let rtA, rtB;
        const options = {
          format: THREE.RGBAFormat,
          type: THREE.HalfFloatType,
          minFilter: THREE.LinearFilter,
          magFilter: THREE.LinearFilter,
          depthBuffer: false,
          stencilBuffer: false,
        };
        const loader = new THREE.TextureLoader();
        const imageTexture = loader.load(getImageUrl(canvasEl), function () {
          const bubbleImgs = document.querySelectorAll('.water-bubble-img');
          if (bubbleImgs.length) {
            bubbleImgs.forEach(function (bubbleImg) {
              bubbleImg.style.display = 'none';
            });
          }
        });
        imageTexture.minFilter = THREE.LinearFilter;
        imageTexture.magFilter = THREE.LinearFilter;
        imageTexture.wrapS = THREE.ClampToEdgeWrapping;
        imageTexture.wrapT = THREE.ClampToEdgeWrapping;
        const simMaterial = new THREE.ShaderMaterial({
          uniforms: {
            textureA: { value: null },
            mouse: { value: mouse },
            resolution: { value: new THREE.Vector2(1, 1) },
            time: { value: 0 },
            frame: { value: 0 },
          },
          vertexShader: `
        varying vec2 vUv;
        void main() {
          vUv = uv;
          gl_Position = vec4(position, 1.0);
        }
      `,
          fragmentShader: `
        uniform sampler2D textureA;
        uniform vec2 mouse;
        uniform vec2 resolution;
        uniform float time;
        uniform int frame;
        varying vec2 vUv;
        const float delta = 1.4;
        void main() {
          vec2 uv = vUv;
          if (frame == 0) {
            gl_FragColor = vec4(0.0);
            return;
          }
          vec4 data = texture2D(textureA, uv);
          float pressure = data.x;
          float pVel = data.y;
          vec2 texelSize = 1.0 / resolution;
          float p_right = texture2D(textureA, uv + vec2(texelSize.x, 0.0)).x;
          float p_left = texture2D(textureA, uv + vec2(-texelSize.x, 0.0)).x;
          float p_up = texture2D(textureA, uv + vec2(0.0, texelSize.y)).x;
          float p_down = texture2D(textureA, uv + vec2(0.0, -texelSize.y)).x;
          pVel += delta * (-2.0 * pressure + p_right + p_left) / 4.0;
          pVel += delta * (-2.0 * pressure + p_up + p_down) / 4.0;
          pressure += delta * pVel;
          pVel -= 0.005 * delta * pressure;
          pVel *= 1.0 - 0.002 * delta;
          pressure *= 0.96;
          vec2 mouseUV = mouse / resolution;
          if (mouse.x > 0.0 || mouse.y > 0.0) {
            float dist = distance(uv, mouseUV);
            if (dist <= 0.01) {
              pressure += 2.0 * (1.0 - dist / 0.02);
            }
          }
          gl_FragColor = vec4(
            pressure,
            pVel,
            (p_right - p_left) * 0.5,
            (p_up - p_down) * 0.5
          );
        }
      `,
        });
        const renderMaterial = new THREE.ShaderMaterial({
          uniforms: {
            textureA: { value: null },
            textureB: { value: imageTexture },
            uvScale: { value: 1 },
          },
          vertexShader: `
        varying vec2 vUv;
        void main() {
          vUv = uv;
          gl_Position = vec4(position, 1.0);
        }
      `,
          fragmentShader: `
        uniform sampler2D textureA;
        uniform sampler2D textureB;
        uniform float uvScale;
        varying vec2 vUv;
        void main() {
          vec4 data = texture2D(textureA, vUv);
          vec2 distortion = 0.12 * data.zw;
          vec2 uv = (vUv - 0.5) * uvScale + 0.5;
          gl_FragColor = texture2D(textureB, uv + distortion);
        }
      `,
          transparent: true,
        });
        const quadGeo = new THREE.PlaneGeometry(2, 2);
        simScene.add(new THREE.Mesh(quadGeo, simMaterial));
        scene.add(new THREE.Mesh(quadGeo, renderMaterial));
        function resize() {
          const rect = canvasEl.getBoundingClientRect();
          if (!rect.width || !rect.height) return;
          const dpr = Math.min(window.devicePixelRatio || 1, 2);
          renderer.setPixelRatio(dpr);
          renderer.setSize(rect.width, rect.height, false);
          const w = Math.max(1, Math.floor(rect.width * dpr));
          const h = Math.max(1, Math.floor(rect.height * dpr));
          simMaterial.uniforms.resolution.value.set(w, h);
          if (!rtA) {
            rtA = new THREE.WebGLRenderTarget(w, h, options);
            rtB = new THREE.WebGLRenderTarget(w, h, options);
          } else {
            rtA.setSize(w, h);
            rtB.setSize(w, h);
          }
        }
        function updateMouseFromEvent(e) {
          const rect = canvasEl.getBoundingClientRect();
          const x = e.clientX - rect.left;
          const y = e.clientY - rect.top;
          const dpr = renderer.getPixelRatio();
          mouse.x = x * dpr;
          mouse.y = (rect.height - y) * dpr;
        }
        canvasEl.addEventListener('mousemove', updateMouseFromEvent);
        canvasEl.addEventListener('mouseleave', function () {
          mouse.set(0, 0);
        });
        window.addEventListener('resize', resize);
        function animate() {
          if (!rtA || !rtB) {
            requestAnimationFrame(animate);
            return;
          }
          simMaterial.uniforms.frame.value = frame++;
          simMaterial.uniforms.time.value = performance.now() / 1000;
          simMaterial.uniforms.textureA.value = rtA.texture;
          renderer.setRenderTarget(rtB);
          renderer.render(simScene, camera);
          renderMaterial.uniforms.textureA.value = rtB.texture;
          renderer.setRenderTarget(null);
          renderer.render(scene, camera);
          const temp = rtA;
          rtA = rtB;
          rtB = temp;
          requestAnimationFrame(animate);
        }
        resize();
        animate();
      }
    }
    /* Do not add anything below this code */
  });
</script>
