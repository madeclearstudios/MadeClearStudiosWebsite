  <link href="/images/favicon-dark.png" rel="icon" type="image/png" sizes="32x32" media="(prefers-color-scheme: dark)">
  <link href="/images/webclip.png" rel="apple-touch-icon">
  {% include "theme.njk" %}
  {#- Slide between case studies: a cross-page view transition (browsers without it just load the page).
      The direction (next/prev) is passed in sessionStorage by js/case-study-nav.js. -#}
  <style>@view-transition { navigation: auto; }</style>
  <script>try{var d=sessionStorage.getItem("cs-dir");if(d){document.documentElement.setAttribute("data-cs-dir",d);sessionStorage.removeItem("cs-dir");}}catch(e){}document.documentElement.classList.add("cs-anim");</script>
  {% include "analytics.njk" %}
  <link href="
https://cdn.jsdelivr.net/npm/@splidejs/splide@4.1.4/dist/css/splide.min.css
" rel="stylesheet">
  <!--  Finsweet Attributes  -->
  <script async="" type="module" src="https://cdn.jsdelivr.net/npm/@finsweet/attributes@2/attributes.js" fs-smartlightbox=""></script>
  <script type="application/ld+json">{{ {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Case Studies", "item": siteUrl + "/case-studies" },
      { "@type": "ListItem", "position": 2, "name": cs.title, "item": siteUrl + "/case-study/" + cs.slug }
    ]
  } | dump | replace("<", "\\u003c") | safe }}</script>
</head>
<body>
  <div class="page-wrapper case-page">
    {% include "global-styles.njk" %}
    <div class="page-embed w-embed">
      <style>
  @media screen and (min-width: 992px) and (max-width: 1200px) {
    .water-bubble.the-second {
      width: 8rem;
      height: 8rem;
      position: absolute;
