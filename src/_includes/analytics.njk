{#- Google Analytics 4 behind cookie consent. Included in every page's <head>.
    Nothing loads from Google until the visitor clicks "Accept" in the cookie banner (js/consent.js),
    so no analytics cookies are set without consent. The choice is remembered for 6 months. -#}
  <script>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  window.MC_GA_ID = 'G-F6SX5N28QT';
  gtag('consent', 'default', { analytics_storage: 'denied', ad_storage: 'denied', ad_user_data: 'denied', ad_personalization: 'denied' });
  gtag('js', new Date());
  gtag('config', window.MC_GA_ID);
  </script>
  {#- Not deferred: it is small, and the banner needs to be on screen with the first frame (see consent.js) -#}
  <script src="/js/consent.js"></script>
  {#- Connect early to the CDNs the page scripts load from -#}
  <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin>
  <link rel="dns-prefetch" href="https://cdnjs.cloudflare.com">
  <link rel="dns-prefetch" href="https://unpkg.com">
