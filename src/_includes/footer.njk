{#- Site footer: email, phone, LinkedIn and YouTube, link columns (case studies, services with published pages,
    the latest 4 insights, core pages), and company details. The YouTube and LinkedIn icons and the award sit
    in the left column under the email and phone. Styles: "Footer links" in css/site.css. -#}
{% include "partner-banner.njk" %}
<footer class="section">
        <div class="container">
          <div class="grid _12-col t_flex t_vertical">
            <div class="_3-col flex relative padding-vertical t_padding-1-5 m_padding-1-25">
              <div class="padding-vertical padding-1-5 width-100-pct t_padding-0">
                <div class="flex vertical">
                  <a href="mailto:hello@madeclearstudios.com" class="link-dark">hello@madeclearstudios.com</a>
                  <div class="link-dark no-hover">+44 (0) 1865 965389</div>
                </div>
                <div class="height-1-5"></div>
                <div class="flex align-start footer-social">
                  <a href="https://www.youtube.com/channel/UCIMsipShKIqESBsOJ5AdlNg" target="_blank" rel="noopener" class="link-dark w-inline-block" aria-label="Made Clear Studios on YouTube">
                    <div class="w-embed"><svg width="32" height="28" viewBox="0 0 32 28" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M31.33 6.56a4.01 4.01 0 0 0-2.83-2.84C26 3.06 16 3.06 16 3.06s-10 0-12.5.66A4.01 4.01 0 0 0 .67 6.56C0 9.08 0 14 0 14s0 4.92.67 7.44a4.01 4.01 0 0 0 2.83 2.84C6 24.94 16 24.94 16 24.94s10 0 12.5-.66a4.01 4.01 0 0 0 2.83-2.84C32 18.92 32 14 32 14s0-4.92-.67-7.44ZM12.73 18.77V9.23L21.09 14l-8.36 4.77Z" fill="currentColor"/></svg></div>
                  </a>
                  <a href="https://www.linkedin.com/company/made-clear-studios/" target="_blank" rel="noopener" class="link-dark w-inline-block" aria-label="Made Clear Studios on LinkedIn">
                    <div class="w-embed"><svg width="28" height="28" viewbox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <g clip-path="url(#clip0_13480_37)">
                          <path d="M25.8283 0H2.09418C0.930748 0 0 0.933333 0 2.02222V25.9778C0 27.0667 0.930748 28 2.09418 28H25.9058C27.0693 28 28 27.0667 28 25.9778V2.02222C27.9224 0.933333 26.9917 0 25.8283 0ZM8.29917 23.8778H4.1108V10.5H8.22161V23.8778H8.29917ZM6.20499 8.63333C4.88643 8.63333 3.80055 7.54444 3.80055 6.22222C3.80055 4.9 4.88643 3.88889 6.20499 3.88889C7.52355 3.88889 8.60942 4.97778 8.60942 6.3C8.60942 7.62222 7.52355 8.63333 6.20499 8.63333ZM23.8116 23.8778H19.7008V17.3444C19.7008 15.7889 19.7008 13.7667 17.5291 13.7667C15.3573 13.7667 15.0471 15.4778 15.0471 17.1889V23.8H10.8587V10.5H14.8144V12.2889H14.892C15.4349 11.2 16.831 10.1111 18.8476 10.1111C23.036 10.1111 23.8116 12.9111 23.8116 16.4889V23.8778Z" fill="currentColor"></path>
                        </g>
                        <defs>
                          <clippath id="clip0_13480_37">
                            <rect width="28" height="28" fill="white"></rect>
                          </clippath>
                        </defs>
                      </svg></div>
                  </a>
                </div>
                <div class="award-footer">
                  <img src="/images/awards/rx-club-logo.png" width="600" height="370" loading="lazy" alt="The Rx Club" class="award-footer-logo">
                  <div class="font-600 text-size-xsmall">Award-winning agency<br>The Rx Club</div>
                </div>
                <div class="height-3 t_height-1-25"></div>
                <div class="flex justify-space-between t_justify-start t_gap-1-25">
                  <a href="/privacy-policy" class="font-600 text-size-xsmall link-dark">Privacy Policy</a>
                  <a href="/terms-conditions" class="font-600 text-size-xsmall link-dark">Terms &amp; Conditions</a>
                  <button type="button" data-cookie-settings class="cookie-settings-link font-600 text-size-xsmall link-dark">Cookie settings</button>
                </div>
              </div>
              <div class="width-1-5 t_none"></div>
              <div class="divider-vertical t_margin-negative"></div>
            </div>
            <div class="_9-col">
              <div class="height-100-pct padding-1-5 t_padding-0">
                <div class="flex vertical justify-space-between height-100-pct padding-vertical t_padding-1-5 m_padding-1-25">
                  {%- set footerServices = services | published | sortByOrder | selectattr("hasPage") | rejectattr("hidden") %}
                  {%- set footerInsights = (insights | published | sort(true, false, "publishedOn")).slice(0, 4) %}
                  <nav class="footer-links" aria-label="Footer">
                    <div class="footer-links_col">
                      <p class="footer-links_title"><a href="/case-studies">Case studies</a></p>
                      <ul role="list">
                        {%- for cs in caseStudies | published | sortByOrder %}
                        <li><a href="/case-study/{{ cs.slug }}">{{ cs.projectTitle or cs.title }}</a></li>
                        {%- endfor %}
                      </ul>
                      <button type="button" class="footer-links_more" aria-expanded="false" hidden><span class="visually-hidden">Show all</span><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg></button>
                    </div>
                    <div class="footer-links_col">
                      <p class="footer-links_title"><a href="/services">Services</a></p>
                      <ul role="list">
                        {%- for svc in footerServices %}
                        <li><a href="/services/{{ svc.slug }}">{{ svc.name }}</a></li>
                        {%- endfor %}
                      </ul>
                      <button type="button" class="footer-links_more" aria-expanded="false" hidden><span class="visually-hidden">Show all</span><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg></button>
                    </div>
                    <div class="footer-links_col">
                      <p class="footer-links_title"><a href="/insights">Insights</a></p>
                      <ul role="list">
                        {%- for i in footerInsights %}
                        <li><a href="/insights/{{ i.slug }}">{{ i.title }}</a></li>
                        {%- endfor %}
                      </ul>
                      <button type="button" class="footer-links_more" aria-expanded="false" hidden><span class="visually-hidden">Show all</span><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg></button>
                    </div>
                    <div class="footer-links_col">
                      <p class="footer-links_title">Made Clear</p>
                      <ul role="list">
                        <li><a href="/">Home</a></li>
                        <li><a href="/about">About</a></li>
                        <li><a href="/services">Services</a></li>
                        <li><a href="/case-studies">Case studies</a></li>
                        <li><a href="/kol-hub">KOL Hub</a></li>
                        <li><a href="/insights">Insights</a></li>
                        <li><a href="/contact">Contact</a></li>
                      </ul>
                      <button type="button" class="footer-links_more" aria-expanded="false" hidden><span class="visually-hidden">Show all</span><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg></button>
                    </div>
                  </nav>
                  <script src="/js/footer-links.js" defer></script>
                  <div class="height-1"></div>
                  <div class="none t_block t_height-1-25 padding-0"></div>
                  <div class="flex justify-space-between">
                    <div class="font-600 text-size-xsmall">© {{ year }} Made Clear Studios Ltd | Registered in England &amp; Wales No. 07323563.<br>Registered Office: 62 St. Bernards Road, Oxford, OX2 6EJ, United Kingdom</div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </footer>
