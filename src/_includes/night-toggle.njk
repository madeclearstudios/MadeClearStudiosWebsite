{#- Night mode switch (js/night-mode.js). Shown in the nav: at the end of the desktop menu, and beside the menu button on phones. -#}
<button type="button" class="night-toggle{{ ' ' + extraClass if extraClass }}" role="switch" aria-checked="false" data-night-toggle>
  <span class="night-toggle_track" aria-hidden="true">
    <span class="night-toggle_thumb">
      <svg class="night-toggle_icon is-sun" viewBox="0 0 24 24" width="12" height="12" focusable="false"><circle cx="12" cy="12" r="4.5" fill="currentColor"/><g stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M12 1.5v2.5M12 20v2.5M1.5 12H4M20 12h2.5M4.6 4.6l1.8 1.8M17.6 17.6l1.8 1.8M4.6 19.4l1.8-1.8M17.6 6.4l1.8-1.8"/></g></svg>
      <svg class="night-toggle_icon is-moon" viewBox="0 0 24 24" width="12" height="12" focusable="false"><path d="M20.5 14.6A8.5 8.5 0 0 1 9.4 3.5a8.5 8.5 0 1 0 11.1 11.1z" fill="currentColor"/></svg>
    </span>
  </span>
  <span class="visually-hidden">Night mode</span>
</button>
