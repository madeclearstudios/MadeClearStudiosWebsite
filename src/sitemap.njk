---
permalink: sitemap.xml
eleventyExcludeFromCollections: true
---
{#- Every page except 404, pages marked `noindex: true` and pages with no address (permalink: false). Case studies,
    insights, service pages and micro case studies are listed from the CMS data (hidden ones are left out).
    lastmod is the date of the last commit that changed the page's file (lastModified filter in eleventy.config.js). -#}
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- for item in collections.all %}{% if item.url and not item.data.noindex and item.url != "/404.html" %}
  <url><loc>{{ siteUrl }}{{ "/" if item.url == "/" else item.url | replace(".html", "") }}</loc><lastmod>{{ item.inputPath | lastModified }}</lastmod></url>
{%- endif %}{% endfor %}
{%- for cs in caseStudies | published %}
  <url><loc>{{ siteUrl }}/case-study/{{ cs.slug }}</loc><lastmod>{{ ("content/case-studies/" + cs.slug + ".json") | lastModified }}</lastmod></url>
{%- endfor %}
{%- for svc in services | published %}{% if svc.hasPage and not svc.hidden %}
  <url><loc>{{ siteUrl }}/services/{{ svc.slug }}</loc><lastmod>{{ ("content/services/" + svc.slug + ".json") | lastModified }}</lastmod></url>
{%- endif %}{% endfor %}
{%- for m in microCaseStudies | published %}{% if not m.hidden %}
  <url><loc>{{ siteUrl }}/work/{{ m.slug }}</loc><lastmod>{{ ("content/micro-case-studies/" + m.slug + ".json") | lastModified }}</lastmod></url>
{%- endif %}{% endfor %}
{%- for insight in insights | published %}
  <url><loc>{{ siteUrl }}/insights/{{ insight.slug }}</loc><lastmod>{{ ("content/insights/" + insight.slug + ".json") | lastModified }}</lastmod></url>
{%- endfor %}
</urlset>
